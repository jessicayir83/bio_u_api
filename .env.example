# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real a un repositorio.

# --- API ---
PORT=5001
NODE_ENV=development

# HTTPS local (solo para probar el kiosco desde un teléfono/tablet: la
# cámara solo funciona en localhost o por HTTPS). Ver README para generar
# los certificados autofirmados.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=../certs/dev-key.pem
HTTPS_CERT_PATH=../certs/dev-cert.pem

# --- SQL Server (BiometricPlatformDB) ---
DB_HOST= ASUS-JESS
DB_PORT= 1433
DB_NAME= BiometricPlatformDB
DB_USER= BiometricPlatformUser
DB_PASSWORD= BioU9826%&**!
# true si tu SQL Server local usa un certificado autofirmado
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=false

# --- Seguridad (Fase 2) ---
JWT_SECRET=reemplaza-esto-por-una-cadena-larga-y-aleatoria
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=biometric-platform-api
JWT_AUDIENCE=biometric-platform-clients
BCRYPT_SALT_ROUNDS=10

# --- Biometría facial (Fase 5) ---
# Ruta a los modelos de face-api.js (relativa al cwd del proceso, normalmente api/)
FACE_MODELS_PATH=models
# Distancia euclidiana máxima para considerar dos rostros la misma persona (0.6 = recomendado por face-api.js)
FACE_MATCH_THRESHOLD=0.6
# Margen mínimo entre el mejor y el segundo mejor match en identificación 1:N
# (si están más cerca que esto, se considera ambiguo y no se identifica)
FACE_IDENTIFY_MARGIN=0.05

# --- Cifrado de templates biométricos (Fase 7) ---
# 64 caracteres hex (32 bytes, AES-256-GCM). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=reemplaza-esto-por-64-caracteres-hex-generados
